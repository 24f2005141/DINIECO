        },
        {
          "id": "49b5c184-9060-4e99-bf8b-26033139f121",
          "comment": "",
          "command": "assertText",
          "target": "css=pre",
          "targets": [],
          "value": "{\"detail\":\"Authentication credentials required\"}"
        }
      ]
    },
    {
