# DINIECO Backend Environment Configuration

# Database (Default: SQLite local database; for PostgreSQL: postgresql://user:password@localhost:5432/dinieco)
DATABASE_URL=sqlite:///./dinieco.db

# JWT & Authentication Secret
SECRET_KEY=dinieco-super-secret-key-smart-dining-2026

# Google Gemini API Key for Live Multi-Component Vision Recognition
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave blank to use the deterministic Computer Vision catalog fallback
GEMINI_API_KEY=

# Smart Dining Pad Hardware Defaults
SMART_PAD_DEVICE_ID=DINIECO-PAD-001
SMART_PAD_FIRMWARE_VERSION=v1.0
CALIBRATION_PRECISION_G=0.5
